<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="24dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_launcher" android:src="@drawable/ic_launcher_foreground" android:contentDescription="@string/activity_main_contentdescription_1" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView style="@style/Text.Heading" android:text="@string/activity_main_text_2" android:textSize="21sp" />
                <TextView style="@style/Text.Body" android:text="@string/activity_main_text_3" android:textSize="11sp" android:letterSpacing="0.12" android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_hero" android:padding="24dp">
            <TextView style="@style/Text.Body" android:text="@string/activity_main_text_4" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:textColor="@color/primary_dark" />
            <TextView style="@style/Text.Heading" android:layout_marginTop="10dp" android:text="@string/activity_main_text_5" android:textSize="28sp" />
            <TextView style="@style/Text.Body" android:layout_marginTop="10dp" android:text="@string/activity_main_text_6" />
            <TextView style="@style/Text.Body" android:layout_marginTop="16dp" android:text="@string/activity_main_text_7" android:textColor="@color/primary_dark" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView style="@style/Text.Heading" android:text="@string/activity_main_text_8" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="24dp" app:strokeColor="#E4E7DF" app:strokeWidth="1dp" app:cardElevation="0dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="220dp">
                <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="240dp" android:scaleType="fitCenter" android:contentDescription="@string/activity_main_contentdescription_9" android:visibility="gone" />
                <LinearLayout android:id="@+id/placeholder" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="20dp" android:layout_gravity="center">
                    <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_launcher_foreground" android:importantForAccessibility="no" />
                    <TextView style="@style/Text.Heading" android:text="@string/activity_main_text_10" android:textSize="17sp" android:gravity="center" android:layout_marginTop="8dp" />
                    <TextView style="@style/Text.Body" android:text="@string/activity_main_text_11" android:gravity="center" android:layout_marginTop="6dp" />
                </LinearLayout>
                <ProgressBar android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center" android:visibility="gone" android:contentDescription="@string/activity_main_contentdescription_12" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/resultCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="#E6F1EB" app:strokeWidth="0dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:accessibilityLiveRegion="polite">
                <TextView android:id="@+id/resultTitle" style="@style/Text.Heading" android:text="@string/activity_main_text_13" android:textColor="@color/primary_dark" android:textSize="18sp" />
                <TextView android:id="@+id/resultScores" style="@style/Text.Body" android:layout_marginTop="10dp" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" android:visibility="gone" />
                <TextView android:id="@+id/resultHint" style="@style/Text.Body" android:layout_marginTop="4dp" android:text="@string/activity_main_text_14" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/cameraBtn" style="@style/Action" android:layout_marginTop="16dp" android:text="@string/activity_main_text_15" android:textColor="#322207" app:backgroundTint="@color/fire" app:icon="@android:drawable/ic_menu_camera" app:iconTint="#322207" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton android:id="@+id/galleryBtn" style="@style/Action" android:text="@string/activity_main_text_16" android:textColor="@color/primary_dark" app:backgroundTint="#E4F0EB" app:icon="@android:drawable/ic_menu_gallery" app:iconTint="@color/primary" app:iconGravity="textStart" />
        <TextView style="@style/Text.Heading" android:layout_marginTop="24dp" android:text="@string/activity_main_text_17" />
        <TextView style="@style/Text.Body" android:layout_marginTop="6dp" android:text="@string/activity_main_text_18" />
        <com.google.android.material.button.MaterialButton android:id="@+id/liveBtn" style="@style/Action" android:layout_marginTop="8dp" android:text="@string/activity_main_text_19" app:backgroundTint="@color/primary" app:icon="@android:drawable/ic_menu_slideshow" app:iconGravity="textStart" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_soft" android:padding="20dp" android:layout_marginTop="24dp">
            <TextView style="@style/Text.Heading" android:text="@string/activity_main_text_20" android:textSize="17sp" />
            <TextView style="@style/Text.Body" android:layout_marginTop="8dp" android:text="@string/activity_main_text_21" />
            <com.google.android.material.button.MaterialButton android:id="@+id/aboutBtn" style="@style/Action" android:text="@string/activity_main_text_22" android:textColor="@color/primary" app:backgroundTint="@android:color/transparent" />
        </LinearLayout>
        <TextView style="@style/Text.Body" android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" android:text="@string/activity_main_text_23" android:textSize="11sp" android:letterSpacing="0.1" />
    </LinearLayout>
</ScrollView>
